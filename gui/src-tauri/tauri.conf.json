{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stm32burn",
  "version": "0.1.1",
  "identifier": "com.tongenshen.stm32burn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "stm32burn — STM32 串口烧录",
        "width": 1000,
        "height": 760,
        "minWidth": 820,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../chips": "chips"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
